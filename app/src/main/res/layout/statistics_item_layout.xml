<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewStatQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Question: What is the capital of France?"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <!-- ✅ This will be hidden in review mode -->
        <TextView
            android:id="@+id/textViewStatUserAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your answer: Paris"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/textViewStatCorrectAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correct answer: Paris"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>